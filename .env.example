# LLM Provider (factory-driven — change ACTIVE_LLM_MODEL to switch models)
# Supported: "google_genai/gemini-flash-latest" | "openai/deepseek-chat"
ACTIVE_LLM_MODEL=gemini-flash-latest
GEMINI_API_KEY=AI...
# DEEPSEEK_API_KEY=sk-...

# LangSmith for Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2-...
LANGCHAIN_PROJECT=ai-scraper-bot

# App Settings
APP_ENV=development
debug=true

# Adzuna API
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_app_key

# JSearch API (RapidAPI)
JSEARCH_API_KEY=your_jsearch_rapidapi_key

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cvviewer
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cvviewer
